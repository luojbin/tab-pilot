{
  "optional_host_permissions": [
    "*://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tabpilot@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "src/app/background.js"
    ]
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "menus"
  ]
}
