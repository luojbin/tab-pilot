{
  "manifest_version": 3,
  "name": "TabPilot",
  "version": "0.4.0",
  "description": "个人用 Firefox 标签页管理器：按规则自动归组、上色，并可在页面内显示分组标识。",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabpilot@local",
      "strict_min_version": "139.0"
    }
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_title": "TabPilot：立即同步标签页"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/highlight.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "src/highlight.js",
      "src/store.js",
      "src/logger.js",
      "src/rules.js",
      "src/actions.js",
      "src/background.js"
    ]
  }
}
