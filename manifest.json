{
  "manifest_version": 3,
  "name": "TabPilot",
  "version": "0.2.0",
  "description": "个人用 Firefox 标签页管理器：按 JSON 规则自动归组与上色。",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabpilot@local",
      "strict_min_version": "139.0"
    }
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_title": "TabPilot：立即同步标签页"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "src/store.js",
      "src/logger.js",
      "src/rules.js",
      "src/actions.js",
      "src/background.js"
    ]
  }
}
