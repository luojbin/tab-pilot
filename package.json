{
  "name": "tab-pilot",
  "version": "1.3.0",
  "private": true,
  "description": "跨浏览器标签页管理器（WebExtensions，支持 Firefox / Chrome / Edge）",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build": "node scripts/build-targets.mjs",
    "build:firefox": "node scripts/build-targets.mjs firefox",
    "lint": "web-ext lint --source-dir dist/firefox",
    "build:chrome": "node scripts/build-targets.mjs chrome",
    "build:edge": "node scripts/build-targets.mjs edge"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "web-ext": "^10.8.0"
  },
  "type": "module"
}
